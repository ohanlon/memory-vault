{
  "name": "cairn",
  "private": true,
  "version": "0.1.0",
  "description": "Open-source, local-first markdown stack + graph viewer for managing Claude memory files.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run typecheck && vite build && npm run build:cli",
    "build:cli": "vite build -c vite.node.config.ts --mode mcp && vite build -c vite.node.config.ts --mode cli && node scripts/build-cli.mjs",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "prepare": "husky"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.0",
    "@codemirror/lang-markdown": "^6.3.1",
    "@codemirror/language-data": "^6.5.2",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.4.1",
    "@codemirror/view": "^6.34.1",
    "@fontsource/arimo": "^5.3.0",
    "@fontsource/montserrat": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/roboto": "^5.3.0",
    "@fontsource/scoutie-sans": "^5.3.1",
    "@fontsource/valley-sans": "^5.3.1",
    "@huggingface/transformers": "^4.3.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@uiw/react-codemirror": "^4.23.6",
    "chokidar": "^3.6.0",
    "dompurify": "^3.4.14",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.12.0",
    "isomorphic-git": "^1.42.6",
    "js-yaml": "^5.3.0",
    "katex": "^0.18.5",
    "marked": "^18.0.10",
    "mustache": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-force-graph-2d": "^1.25.5",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@types/dompurify": "^3.0.5",
    "@types/js-yaml": "^4.0.9",
    "@types/mustache": "^4.2.6",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "happy-dom": "^20.14.3",
    "husky": "^9.1.7",
    "playwright": "^1.63.0",
    "postject": "^1.0.0-alpha.6",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
