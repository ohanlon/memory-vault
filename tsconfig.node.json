{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "baseUrl": ".",
    "paths": {
      "@shared/*": ["shared/*"]
    }
  },
  "include": ["electron", "shared", "vite.config.ts", "vite.node.config.ts"],
  "exclude": ["electron/main.ts", "electron/preload.ts", "electron/exportFiles.ts", "electron/attachmentProtocol.ts", "electron/pluginProtocol.ts", "electron/attachmentProtocol.test.ts", "electron/pluginProtocol.test.ts"]
}
